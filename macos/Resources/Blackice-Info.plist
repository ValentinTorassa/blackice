<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Blackice.app. Its executable is the blackice CLI. Adapted from blackice-poc
     macos/Resources/Host-Info.plist at commit 45a7870. scripts/build-app.sh sets CFBundleVersion. -->
<plist version="1.0"><dict>
    <key>CFBundleIdentifier</key><string>com.valentorassa.blackice</string>
    <key>CFBundleExecutable</key><string>blackice</string>
    <key>CFBundleName</key><string>Blackice</string>
    <key>CFBundleDisplayName</key><string>Blackice</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>CFBundleShortVersionString</key><string>0.3.1</string>
    <!-- Contents/Resources/AppIcon.icns, built from Resources/AppIcon.svg by scripts/make-icon.sh. -->
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSUIElement</key><true/>
    <key>NSSystemExtensionUsageDescription</key>
    <string>blackice filters new outbound connections according to blackice.toml.</string>
</dict></plist>
