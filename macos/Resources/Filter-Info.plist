<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The content filter system extension. Adapted from blackice-poc macos/Resources/Filter-Info.plist
     at commit 45a7870. NEMachServiceName is a placeholder: scripts/sign.sh replaces it with the
     Team ID, the bundle ID and CFBundleVersion, so the name sits under the extension's app group
     and each build has its own. The executable is named after the bundle ID, as Xcode names
     system extensions. scripts/build-app.sh sets CFBundleVersion. -->
<plist version="1.0"><dict>
    <key>CFBundleIdentifier</key><string>com.valentorassa.blackice.filter</string>
    <key>CFBundleExecutable</key><string>com.valentorassa.blackice.filter</string>
    <key>CFBundleName</key><string>BlackiceFilter</string>
    <key>CFBundleDisplayName</key><string>Blackice Filter</string>
    <key>CFBundlePackageType</key><string>SYSX</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>CFBundleShortVersionString</key><string>0.4.5</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>NSSystemExtensionUsageDescription</key>
    <string>Blackice filters outgoing connections so each app reaches only the hosts you, or the agent you chose, approve.</string>
    <key>NetworkExtension</key><dict>
        <key>NEMachServiceName</key><string>TEAM_ID.com.valentorassa.blackice.filter.BUILD</string>
        <key>NEProviderClasses</key><dict>
            <key>com.apple.networkextension.filter-data</key>
            <string>BlackiceFilterDataProvider</string>
        </dict>
    </dict>
</dict></plist>
