diff --git a/src/builtins/hooks/blackice.zig b/src/builtins/hooks/blackice.zig
new file mode 100644
index 0000000..bc53903
--- /dev/null
+++ b/src/builtins/hooks/blackice.zig
@@ -0,0 +1,532 @@
+//! blackice task scopes for the commands fx runs.
+//!
+//! This file is a declared patch to fx v0.0.16, kept in the blackice repository (integrations/fx). It is not
+//! part of upstream fx.
+//!
+//! Enabled when FX_BLACKICE_POLICY names a policy file (absolute path). FX_BLACKICE_BIN must then name the
+//! blackice executable by its real path (absolute, no symlinks). At start the hook pins the policy (its
+//! sha256) and finds fx's own executable. A PreToolUse handler acts before fx validates, reviews or runs a
+//! tool call:
+//! - Only these tools run: shell, read_file, write_file, edit_file, glob_files, grep_files,
+//!   ask_user_question, read_tool_result, skill and subagent (a subagent's calls pass through this same
+//!   hook). Every other tool (web_fetch, web_search, install_skill, mcp_select_tool, MCP tools, vision,
+//!   capability_search, and any tool added later) would act from fx itself, outside every scope, so it is
+//!   blocked.
+//! - write_file and edit_file also run in fx, outside the scopes, so they may only use a relative path with no
+//!   "..": fx then keeps the write inside the workspace (its working directory at start), symlinks included.
+//!   blackice, fx and the policy must be outside the workspace, or every call is blocked. Reads (read_file,
+//!   glob_files, grep_files) are not limited: what they read goes to the model provider. blackice limits what
+//!   scoped commands send over the network, not what the model can read.
+//! - `shell` run (action "run", or no action and a command) is rewritten to
+//!       '<blackice>' run --policy-sha256 '<hash>' --protect '<fx>' [--protect '<profile file>' ...]
+//!           --policy '<policy>' -- '<shell>' <flags> '-c' '<command>'
+//!   with profile "clean". The command starts in its own blackice task scope: network only through the
+//!   scope's proxy, decided by the pinned policy, with receipts, and a clean environment. fx's own outer shell
+//!   reads no startup files, because a scoped command can edit them (~/.zshrc) and the outer shell runs
+//!   outside the scope. The inner shell is $SHELL when it is sh, bash or zsh, else /bin/sh, and also skips
+//!   startup files. blackice refuses a policy whose hash changed, and inside the scope it refuses writes to
+//!   itself, to the policy and to fx's executable (which fx re-runs for every command on macOS), so one
+//!   command cannot unscope the next. It also refuses writes to fx's profile files that pick the next
+//!   session's provider, model, credential and MCP servers (~/.fx/settings.json, mcp.json, auth.json,
+//!   api-key, chatgpt-auth.json, grok-auth.json), each one that exists when fx starts.
+//! - `shell` reload, tty sessions and the `shell` field are blocked: reload re-reads startup files for the
+//!   outer shell, and a tty session runs fx's bootstrap outside the scope.
+//! - `shell` interact and stop: unchanged; they talk to a command started inside a scope.
+//! - A call that cannot be read safely (a request wrapper, a command that is not a string or holds a NUL
+//!   byte) is blocked, never run unscoped. A misconfiguration blocks every call.
+//!
+//! fx starts no MCP servers in this mode (src/builtins/mcp.zig asks `requested`): they would run outside every
+//! scope, from ~/.fx/mcp.json or a project's .mcp.json, which a scoped command can write.
+//!
+//! fx's own permission modes still apply, to the rewritten command. fx itself, its model traffic and its
+//! own git calls (safe_git, at fixed system paths) stay outside the scopes. `fx acp` refuses to start in
+//! this mode.
+
+const std = @import("std");
+const hooks = @import("../../core/hooks/hooks.zig");
+const io_mod = @import("../../core/shared/io.zig");
+
+pub const handler_name = "blackice.scope_shell";
+
+/// fx's profile files under ~/.fx that pick the next session's provider, model, credential and MCP servers.
+/// Each one that exists when fx starts is protected inside every scope.
+const profile_file_names = [_][]const u8{ "settings.json", "mcp.json", "auth.json", "api-key", "chatgpt-auth.json", "grok-auth.json" };
+
+/// Whether blackice mode was asked for (FX_BLACKICE_POLICY is set, even when it is wrong). fx then starts no
+/// MCP servers.
+pub fn requested() bool {
+    return requestedBy(io_mod.getenv("FX_BLACKICE_POLICY"));
+}
+
+fn requestedBy(policy_env: ?[]const u8) bool {
+    return policy_env != null;
+}
+
+/// The tools that may run in blackice mode.
+const allowed_tools = [_][]const u8{
+    "shell",      "read_file",         "write_file",       "edit_file", "glob_files",
+    "grep_files", "ask_user_question", "read_tool_result", "skill",     "subagent",
+};
+
+pub const State = struct {
+    enabled: bool = false,
+    /// When set, every call is blocked with this reason (misconfiguration fails closed).
+    problem: ?[]const u8 = null,
+    bin: []const u8 = "",
+    policy: []const u8 = "",
+    policy_sha256: [64]u8 = @splat('0'),
+    pinned: bool = false,
+    /// fx's own executable, protected inside every scope.
+    fx_exe: []const u8 = "",
+    fx_exe_buf: [std.Io.Dir.max_path_bytes]u8 = undefined,
+    /// $SHELL when it is a POSIX shell.
+    default_shell: ?[]const u8 = null,
+    /// fx's profile files that exist (absolute paths), protected inside every scope.
+    profile: [profile_file_names.len][]const u8 = undefined,
+    profile_count: usize = 0,
+
+    pub fn initFromEnv(state: *State) void {
+        state.configure(io_mod.getenv("FX_BLACKICE_POLICY"), io_mod.getenv("FX_BLACKICE_BIN"), io_mod.getenv("SHELL"));
+        if (!state.enabled or state.problem != null) return;
+        const io = io_mod.getIo();
+        const gpa = std.heap.page_allocator;
+
+        // A symlink in a user directory could be re-pointed by a scoped command; the real path cannot be
+        // changed from inside a scope (blackice protects it and its parents).
+        const real = io_mod.realpathAlloc(gpa, state.bin) catch {
+            state.problem = "blackice: FX_BLACKICE_BIN cannot be resolved; it must name the blackice executable.";
+            return;
+        };
+        defer gpa.free(real);
+        if (!std.mem.eql(u8, real, state.bin)) {
+            state.problem = "blackice: FX_BLACKICE_BIN must be the executable's real path (no symlinks).";
+            return;
+        }
+
+        var file = io_mod.openExistingReadOnlyRegularFile(std.Io.Dir.cwd(), state.policy, .follow) catch {
+            state.problem = "blackice: FX_BLACKICE_POLICY cannot be read.";
+            return;
+        };
+        defer file.close(io);
+        const bytes = io_mod.readFileToEnd(gpa, &file, 1 << 20) catch {
+            state.problem = "blackice: FX_BLACKICE_POLICY cannot be read.";
+            return;
+        };
+        defer gpa.free(bytes);
+        state.pin(bytes);
+
+        const exe_len = std.process.executablePath(io, &state.fx_exe_buf) catch {
+            state.problem = "blackice: fx cannot find its own executable to protect it.";
+            return;
+        };
+        state.fx_exe = state.fx_exe_buf[0..exe_len];
+
+        // fx's file tools run outside the scopes and may write anywhere in the workspace (fx's working
+        // directory at start), so blackice, fx and the policy must live elsewhere.
+        const workspace = io_mod.realpathAlloc(gpa, ".") catch {
+            state.problem = "blackice: the workspace directory cannot be resolved.";
+            return;
+        };
+        defer gpa.free(workspace);
+        const policy_real = io_mod.realpathAlloc(gpa, state.policy) catch {
+            state.problem = "blackice: FX_BLACKICE_POLICY cannot be resolved.";
+            return;
+        };
+        defer gpa.free(policy_real);
+        const fx_real = io_mod.realpathAlloc(gpa, state.fx_exe) catch {
+            state.problem = "blackice: fx cannot resolve its own executable.";
+            return;
+        };
+        defer gpa.free(fx_real);
+        if (inside(workspace, state.bin) or inside(workspace, policy_real) or inside(workspace, fx_real)) {
+            state.problem = "blackice: blackice, fx and the policy must be outside the workspace, where fx's own file tools could change them. Install them elsewhere (root-owned is best).";
+            return;
+        }
+
+        // A scoped command must not pick the next session's provider, credential or MCP servers.
+        const home = io_mod.homeDir() orelse return;
+        if (!absolute(home)) {
+            state.problem = "blackice: HOME must be an absolute path.";
+            return;
+        }
+        for (profile_file_names) |name| {
+            const path = std.Io.Dir.path.join(gpa, &.{ home, ".fx", name }) catch {
+                state.problem = "blackice: out of memory.";
+                return;
+            };
+            _ = std.Io.Dir.cwd().statFile(io, path, .{ .follow_symlinks = false }) catch {
+                gpa.free(path);
+                continue;
+            };
+            state.profile[state.profile_count] = path;
+            state.profile_count += 1;
+        }
+    }
+
+    pub fn configure(state: *State, policy: ?[]const u8, bin: ?[]const u8, shell: ?[]const u8) void {
+        const p = policy orelse return;
+        state.enabled = true;
+        if (!absolute(p)) {
+            state.problem = "blackice: FX_BLACKICE_POLICY must be an absolute path to a policy file.";
+            return;
+        }
+        state.policy = p;
+        const b = bin orelse {
+            state.problem = "blackice: set FX_BLACKICE_BIN to the blackice executable (absolute path).";
+            return;
+        };
+        if (!absolute(b)) {
+            state.problem = "blackice: FX_BLACKICE_BIN must be an absolute path to the blackice executable.";
+            return;
+        }
+        state.bin = b;
+        if (shell) |s| {
+            if (shellKind(s) != null) state.default_shell = s;
+        }
+    }
+
+    /// Pins the policy: blackice refuses to start a scope if the file no longer hashes to this.
+    pub fn pin(state: *State, policy_bytes: []const u8) void {
+        var digest: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(policy_bytes, &digest, .{});
+        state.policy_sha256 = std.fmt.bytesToHex(digest, .lower);
+        state.pinned = true;
+    }
+};
+
+fn absolute(path: []const u8) bool {
+    return path.len > 0 and path[0] == '/' and std.mem.findScalar(u8, path, 0) == null;
+}
+
+/// `path` is `root` or below it.
+fn inside(root: []const u8, path: []const u8) bool {
+    if (!std.mem.startsWith(u8, path, root)) return false;
+    return path.len == root.len or path[root.len] == '/' or (root.len > 0 and root[root.len - 1] == '/');
+}
+
+/// A path fx's file tools keep inside the workspace: relative, not starting with "~", with no ".." part. fx
+/// treats anything else as an external path that only its permission rules guard, and those do not ask in
+/// permissive modes. fx trims the same whitespace before it classifies a path.
+fn workspacePath(raw: []const u8) bool {
+    const path = std.mem.trim(u8, raw, " \t\r\n");
+    if (path.len == 0 or path[0] == '/' or path[0] == '~') return false;
+    if (std.mem.findScalar(u8, path, 0) != null or std.mem.findScalar(u8, path, '\\') != null) return false;
+    var parts = std.mem.splitScalar(u8, path, '/');
+    while (parts.next()) |part| if (std.mem.eql(u8, part, "..")) return false;
+    return true;
+}
+
+pub fn register(runtime: *hooks.Runtime, state: *State) !void {
+    if (!state.enabled) return;
+    try runtime.registerPreToolUse(.{ .name = handler_name, .ctx = state, .run = preToolUse });
+}
+
+const ShellKind = enum { sh, bash, zsh };
+
+/// POSIX shells the rewrite knows how to start without startup files.
+fn shellKind(path: []const u8) ?ShellKind {
+    if (!absolute(path)) return null;
+    const base = if (std.mem.findScalarLast(u8, path, '/')) |i| path[i + 1 ..] else path;
+    if (std.mem.eql(u8, base, "bash")) return .bash;
+    if (std.mem.eql(u8, base, "zsh")) return .zsh;
+    if (std.mem.eql(u8, base, "sh") or std.mem.eql(u8, base, "dash") or std.mem.eql(u8, base, "ksh")) return .sh;
+    return null;
+}
+
+/// One POSIX single-quoted word: nothing inside is special except the quote, written as '\''.
+fn appendQuoted(out: *std.ArrayList(u8), gpa: std.mem.Allocator, s: []const u8) !void {
+    try out.append(gpa, '\'');
+    for (s) |c| {
+        if (c == '\'') try out.appendSlice(gpa, "'\\''") else try out.append(gpa, c);
+    }
+    try out.append(gpa, '\'');
+}
+
+/// The rewritten command line. Every word is quoted. Caller owns the result.
+fn wrapCommand(gpa: std.mem.Allocator, state: *const State, shell_path: []const u8, command: []const u8) ![]u8 {
+    const kind = shellKind(shell_path) orelse return error.UnsupportedShell;
+    if (!state.pinned) return error.PolicyNotPinned;
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(gpa);
+    try appendQuoted(&out, gpa, state.bin);
+    try out.appendSlice(gpa, " run --policy-sha256 ");
+    try appendQuoted(&out, gpa, &state.policy_sha256);
+    if (state.fx_exe.len > 0) {
+        try out.appendSlice(gpa, " --protect ");
+        try appendQuoted(&out, gpa, state.fx_exe);
+    }
+    for (state.profile[0..state.profile_count]) |path| {
+        try out.appendSlice(gpa, " --protect ");
+        try appendQuoted(&out, gpa, path);
+    }
+    try out.appendSlice(gpa, " --policy ");
+    try appendQuoted(&out, gpa, state.policy);
+    try out.appendSlice(gpa, " -- ");
+    try appendQuoted(&out, gpa, shell_path);
+    const flags: []const []const u8 = switch (kind) {
+        .zsh => &.{"-f"},
+        .bash => &.{ "--noprofile", "--norc" },
+        .sh => &.{},
+    };
+    for (flags) |flag| {
+        try out.append(gpa, ' ');
+        try appendQuoted(&out, gpa, flag);
+    }
+    try out.appendSlice(gpa, " '-c' ");
+    try appendQuoted(&out, gpa, command);
+    return out.toOwnedSlice(gpa);
+}
+
+const Decision = union(enum) {
+    keep,
+    /// New arguments JSON.
+    rewrite: []u8,
+    block: []const u8,
+};
+
+fn isAllowed(tool_name: []const u8) bool {
+    for (allowed_tools) |t| if (std.mem.eql(u8, t, tool_name)) return true;
+    return false;
+}
+
+/// A field that is absent, null or false.
+fn offOrAbsent(object: std.json.ObjectMap, name: []const u8) bool {
+    const v = object.get(name) orelse return true;
+    return switch (v) {
+        .null => true,
+        .bool => |b| !b,
+        else => false,
+    };
+}
+
+/// The whole decision, separate from the hook plumbing so it can be tested.
+fn decide(arena: std.mem.Allocator, state: *const State, tool_name: []const u8, arguments_json: []const u8) !Decision {
+    if (state.problem) |p| return .{ .block = p };
+    if (std.mem.eql(u8, tool_name, "web_fetch") or std.mem.eql(u8, tool_name, "web_search"))
+        return .{ .block = "blackice: fx's own web tools run outside every blackice scope, so they are off. " ++
+            "Use a shell command (for example curl) instead; it runs in a scope under the network policy." };
+    if (!isAllowed(tool_name))
+        return .{ .block = "blackice: this tool would act from fx itself, outside every blackice scope, so it is off in blackice mode." };
+    if (std.mem.eql(u8, tool_name, "write_file") or std.mem.eql(u8, tool_name, "edit_file")) {
+        // These run in fx, outside the scopes: keep them to the workspace, where blackice, fx and the policy
+        // are not (checked at start).
+        const args = std.json.parseFromSliceLeaky(std.json.Value, arena, arguments_json, .{}) catch
+            return .{ .block = "blackice: the file tool arguments are not a JSON object; the call was not run." };
+        if (args != .object or args.object.get("request") != null)
+            return .{ .block = "blackice: send the file tool fields at the top level." };
+        const path = args.object.get("path") orelse return .{ .block = "blackice: a file write needs a path." };
+        if (path != .string or !workspacePath(path.string))
+            return .{ .block = "blackice: in blackice mode fx writes files only inside the workspace, by a relative path without \"..\". Use a shell command for anything else; it runs in a scope." };
+        return .keep;
+    }
+    if (!std.mem.eql(u8, tool_name, "shell")) return .keep;
+
+    const parsed = std.json.parseFromSliceLeaky(std.json.Value, arena, arguments_json, .{}) catch
+        return .{ .block = "blackice: the shell arguments are not a JSON object; the call was not run." };
+    if (parsed != .object) return .{ .block = "blackice: the shell arguments are not a JSON object; the call was not run." };
+    var object = parsed.object;
+    if (object.get("request") != null)
+        return .{ .block = "blackice: send the shell fields at the top level (no request wrapper)." };
+
+    const starts_command = if (object.get("action")) |a| switch (a) {
+        .string => |s| std.mem.eql(u8, s, "run"),
+        .null => object.get("command") != null,
+        else => return .{ .block = "blackice: the shell action must be run, interact or stop." },
+    } else object.get("command") != null;
+    if (!starts_command) return .keep;
+
+    if (!offOrAbsent(object, "tty"))
+        return .{ .block = "blackice: tty sessions are off in blackice mode (fx's terminal bootstrap runs outside the scope). Run the command without tty." };
+    if (!offOrAbsent(object, "reload"))
+        return .{ .block = "blackice: reload is off in blackice mode; commands run in a clean shell with no startup files." };
+    if (object.get("shell")) |sv| if (sv != .null)
+        return .{ .block = "blackice: the shell field is off in blackice mode; commands run in a clean POSIX shell." };
+
+    const command = switch (object.get("command") orelse return .{ .block = "blackice: a shell run needs a command." }) {
+        .string => |s| s,
+        else => return .{ .block = "blackice: the shell command must be a string." },
+    };
+    if (std.mem.findScalar(u8, command, 0) != null) return .{ .block = "blackice: the shell command holds a NUL byte." };
+
+    const wrapped = wrapCommand(arena, state, state.default_shell orelse "/bin/sh", command) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return .{ .block = "blackice: the call could not be prepared for a scope; it was not run." },
+    };
+    try object.put(arena, "command", .{ .string = wrapped });
+    // fx's outer shell must not read startup files a scoped command could have edited.
+    try object.put(arena, "profile", .{ .string = "clean" });
+    _ = object.orderedRemove("shell");
+    _ = object.orderedRemove("reload");
+    _ = object.orderedRemove("tty");
+    const json = try arena.print("{f}", .{std.json.fmt(std.json.Value{ .object = object }, .{})});
+    return .{ .rewrite = json };
+}
+
+/// The returned slices must stay valid until the hook runtime copies them, which it does right after this
+/// handler returns, on the same thread.
+threadlocal var last_arena: ?std.heap.ArenaAllocator = null;
+
+fn preToolUse(ctx: *anyopaque, input: hooks.PreToolUseInput) hooks.HandlerError!hooks.PreToolUseAction {
+    const state: *const State = @ptrCast(@alignCast(ctx));
+    if (last_arena) |*a| a.deinit();
+    last_arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    const arena = last_arena.?.allocator();
+    const decision = decide(arena, state, input.tool_name, input.arguments_json) catch
+        return .{ .block = "blackice: the call could not be prepared for a scope; it was not run." };
+    return switch (decision) {
+        .keep => .continue_,
+        .rewrite => |json| .{ .rewrite_arguments = json },
+        .block => |reason| .{ .block = reason },
+    };
+}
+
+// ---------------------------------------------------------------- tests
+
+const testing = std.testing;
+
+fn testState() State {
+    var s: State = .{};
+    s.configure("/home/example/policy.json", "/usr/local/bin/blackice", "/bin/zsh");
+    s.pin("{\"version\":\"blackice.policy/v0\"}");
+    s.fx_exe = "/home/example/.local/bin/fx";
+    return s;
+}
+
+test "a shell run is rewritten into a pinned scope with a clean outer shell" {
+    var arena_state = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const s = testState();
+    const d = try decide(arena, &s, "shell",
+        \\{"action":"run","command":"echo 'it''s' && curl -s https://example.com | head -1","cwd":"src","profile":"user"}
+    );
+    const v = try std.json.parseFromSliceLeaky(std.json.Value, arena, d.rewrite, .{});
+    try testing.expectEqualStrings("src", v.object.get("cwd").?.string);
+    try testing.expectEqualStrings("clean", v.object.get("profile").?.string);
+    const want = try arena.print("'/usr/local/bin/blackice' run --policy-sha256 '{s}' --protect '/home/example/.local/bin/fx' --policy '/home/example/policy.json' -- '/bin/zsh' '-f' '-c' 'echo '\\''it'\\'''\\''s'\\'' && curl -s https://example.com | head -1'", .{&s.policy_sha256});
+    try testing.expectEqualStrings(want, v.object.get("command").?.string);
+}
+
+test "a command without an action is still a run; interact and stop are kept" {
+    var arena_state = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const s = testState();
+    try testing.expect((try decide(arena, &s, "shell", "{\"command\":\"ls\"}")) == .rewrite);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":null,\"command\":\"ls\"}")) == .rewrite);
+    const off = try decide(arena, &s, "shell", "{\"action\":\"run\",\"command\":\"ls\",\"tty\":false,\"reload\":false}");
+    try testing.expect(std.mem.find(u8, off.rewrite, "reload") == null);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"interact\",\"session_id\":\"shell-1\",\"chars\":\"y\\n\"}")) == .keep);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"stop\",\"session_id\":\"shell-1\"}")) == .keep);
+}
+
+test "file writes stay inside the workspace" {
+    var arena_state = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const s = testState();
+    for ([_][]const u8{ "write_file", "edit_file" }) |t| {
+        try testing.expect((try decide(arena, &s, t, "{\"path\":\"src/a.zig\",\"content\":\"x\"}")) == .keep);
+        try testing.expect((try decide(arena, &s, t, "{\"path\":\"./notes.md\"}")) == .keep);
+        for ([_][]const u8{
+            "{\"path\":\"/usr/local/bin/blackice\"}",
+            "{\"path\":\" /abs\"}",
+            "{\"path\":\"~/.local/bin/fx\"}",
+            "{\"path\":\"~\"}",
+            "{\"path\":\"../outside\"}",
+            "{\"path\":\"a/../../outside\"}",
+            "{\"path\":\"a/..\"}",
+            "{\"path\":\"\"}",
+            "{\"path\":7}",
+            "{}",
+            "{\"request\":{\"path\":\"a\"}}",
+            "not json",
+        }) |args| try testing.expect((try decide(arena, &s, t, args)) == .block);
+    }
+}
+
+test "fx's existing profile files are protected in every scope" {
+    var arena_state = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    var s = testState();
+    s.profile[0] = "/home/example/.fx/settings.json";
+    s.profile[1] = "/home/example/.fx/api-key";
+    s.profile_count = 2;
+    const d = try decide(arena, &s, "shell", "{\"command\":\"ls\"}");
+    try testing.expect(std.mem.find(u8, d.rewrite, "--protect '/home/example/.local/bin/fx' --protect '/home/example/.fx/settings.json' --protect '/home/example/.fx/api-key' --policy ") != null);
+    // blackice run takes at most 8 --protect paths: fx plus every profile file fits.
+    try testing.expect(1 + profile_file_names.len <= 8);
+}
+
+test "blackice mode is asked for by FX_BLACKICE_POLICY, even when it is wrong" {
+    try testing.expect(!requestedBy(null));
+    try testing.expect(requestedBy("/home/example/policy.json"));
+    try testing.expect(requestedBy(""));
+}
+
+test inside {
+    try testing.expect(inside("/w", "/w"));
+    try testing.expect(inside("/w", "/w/bin/blackice"));
+    try testing.expect(!inside("/w", "/work/bin"));
+    try testing.expect(inside("/", "/usr/bin"));
+}
+
+test "only the listed tools run" {
+    var arena_state = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const s = testState();
+    for ([_][]const u8{ "read_file", "glob_files", "grep_files", "ask_user_question", "read_tool_result", "skill", "subagent" }) |t| {
+        try testing.expect((try decide(arena, &s, t, "{}")) == .keep);
+    }
+    for ([_][]const u8{ "write_file", "edit_file" }) |t| {
+        try testing.expect((try decide(arena, &s, t, "{\"path\":\"a.txt\"}")) == .keep);
+    }
+    for ([_][]const u8{ "web_fetch", "web_search", "install_skill", "mcp_select_tool", "capability_search", "vision", "mcp__github__create_issue", "some_new_tool", "" }) |t| {
+        try testing.expect((try decide(arena, &s, t, "{}")) == .block);
+    }
+}
+
+test "unsafe or unknown shapes are blocked, never run unscoped" {
+    var arena_state = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const s = testState();
+    try testing.expect((try decide(arena, &s, "shell", "{\"request\":{\"command\":\"ls\"}}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"run\",\"command\":[\"ls\"]}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"run\",\"command\":\"ls\\u0000x\"}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"run\",\"command\":\"ls\",\"tty\":true}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"run\",\"command\":\"ls\",\"reload\":true}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"run\",\"command\":\"ls\",\"reload\":\"yes\"}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":\"run\",\"command\":\"ls\",\"shell\":{\"kind\":\"executable\",\"path\":\"/bin/bash\"}}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "{\"action\":7,\"command\":\"ls\"}")) == .block);
+    try testing.expect((try decide(arena, &s, "shell", "not json")) == .block);
+}
+
+test "misconfiguration fails closed" {
+    var arena_state = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    var rel: State = .{};
+    rel.configure("relative/policy.json", "/usr/local/bin/blackice", null);
+    try testing.expect(rel.enabled);
+    try testing.expect((try decide(arena, &rel, "shell", "{\"command\":\"ls\"}")) == .block);
+    try testing.expect((try decide(arena, &rel, "read_file", "{\"path\":\"a\"}")) == .block);
+    var no_bin: State = .{};
+    no_bin.configure("/p.json", null, null);
+    try testing.expect((try decide(arena, &no_bin, "shell", "{\"command\":\"ls\"}")) == .block);
+    var off: State = .{};
+    off.configure(null, null, null);
+    try testing.expect(!off.enabled);
+    // Not pinned: no scope can be prepared, so the call is blocked.
+    var unpinned: State = .{};
+    unpinned.configure("/p.json", "/b/blackice", null);
+    try testing.expect((try decide(arena, &unpinned, "shell", "{\"command\":\"ls\"}")) == .block);
+    // fish as $SHELL falls back to /bin/sh.
+    var f: State = .{};
+    f.configure("/p.json", "/b/blackice", "/usr/bin/fish");
+    f.pin("{}");
+    const d = try decide(arena, &f, "shell", "{\"command\":\"ls\"}");
+    try testing.expect(std.mem.find(u8, d.rewrite, "--policy '/p.json' -- '/bin/sh' '-c' 'ls'") != null);
+}
