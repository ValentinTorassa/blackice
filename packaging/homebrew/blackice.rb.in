# Generated by scripts/release/brew-formula.sh from reviewed release checksums.
class Blackice < Formula
  desc "Network policy for local commands"
  homepage "https://github.com/ValentinTorassa/blackice"
  version "@@VERSION@@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-aarch64-macos",
          using: :nounzip
      sha256 "@@MAC_ARM_SHA@@"
    end
    on_intel do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-x86_64-macos",
          using: :nounzip
      sha256 "@@MAC_INTEL_SHA@@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-aarch64-linux",
          using: :nounzip
      sha256 "@@LINUX_ARM_SHA@@"

      resource "linux-helper" do
        url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-linux-helper-@@VERSION@@-aarch64-linux",
            using: :nounzip
        sha256 "@@HELPER_ARM_SHA@@"
      end
    end
    on_intel do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-x86_64-linux",
          using: :nounzip
      sha256 "@@LINUX_INTEL_SHA@@"

      resource "linux-helper" do
        url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-linux-helper-@@VERSION@@-x86_64-linux",
            using: :nounzip
        sha256 "@@HELPER_INTEL_SHA@@"
      end
    end

    resource "linux-setup" do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/linux-setup.sh", using: :nounzip
      sha256 "@@SETUP_SHA@@"
    end
    resource "linux-teardown" do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/linux-teardown.sh", using: :nounzip
      sha256 "@@TEARDOWN_SHA@@"
    end
    resource "checksums" do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/SHA256SUMS", using: :nounzip
      sha256 "@@MANIFEST_SHA@@"
    end
  end

  # Keep the installed executables and setup data identical to the release bytes.
  skip_clean "bin/blackice", "share/blackice/linux-setup"

  def install
    arch = Hardware::CPU.arm? ? "aarch64" : "x86_64"
    os = OS.mac? ? "macos" : "linux"
    bin.install "blackice-@@VERSION@@-#{arch}-#{os}" => "blackice"
    (bin/"blackice").chmod 0755
    return unless OS.linux?

    setup = share/"blackice/linux-setup"
    resource("linux-helper").stage do
      setup.install "blackice-linux-helper-@@VERSION@@-#{arch}-linux"
    end
    resource("linux-setup").stage { setup.install "linux-setup.sh" }
    resource("linux-teardown").stage { setup.install "linux-teardown.sh" }
    resource("checksums").stage { setup.install "SHA256SUMS" }
    setup.children.each { |path| path.chmod 0644 }
  end

  def caveats
    return unless OS.linux?

    helper = resource("linux-helper")
    setup = opt_share/"blackice/linux-setup"
    <<~EOS
      Linux task scopes require a separate root setup. After reviewing the release, run:
        sudo bash "#{setup}/linux-setup.sh" "$USER" #{helper.checksum} "#{setup}/#{File.basename(helper.url)}"

      Homebrew only copied the setup files; it did not grant capabilities or run setup.
      Repeat the manual setup after reboot.
    EOS
  end

  test do
    system bin/"blackice", "version"
  end
end
