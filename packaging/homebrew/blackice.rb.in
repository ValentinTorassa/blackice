# Generated by scripts/release/brew-formula.sh from reviewed release checksums.
class Blackice < Formula
  desc "Network policy for local commands"
  homepage "https://github.com/ValentinTorassa/blackice"
  version "@@VERSION@@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-aarch64-macos",
          using: :nounzip
      sha256 "@@MAC_ARM_SHA@@"
    end
    on_intel do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-x86_64-macos",
          using: :nounzip
      sha256 "@@MAC_INTEL_SHA@@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-aarch64-linux",
          using: :nounzip
      sha256 "@@LINUX_ARM_SHA@@"
    end
    on_intel do
      url "https://github.com/ValentinTorassa/blackice/releases/download/v@@VERSION@@/blackice-@@VERSION@@-x86_64-linux",
          using: :nounzip
      sha256 "@@LINUX_INTEL_SHA@@"
    end
  end

  # Keep the installed executable identical to the release bytes.
  skip_clean "bin/blackice"

  def install
    arch = Hardware::CPU.arm? ? "aarch64" : "x86_64"
    os = OS.mac? ? "macos" : "linux"
    bin.install "blackice-@@VERSION@@-#{arch}-#{os}" => "blackice"
    (bin/"blackice").chmod 0755
  end

  def caveats
    return unless OS.linux?

    if Hardware::CPU.arm?
      return <<~EOS
        Linux arm64 currently ships only the CLI; task scopes are not supported yet.
        The privileged helper is pending a verified arm64 Linux run.
        See docs/linux.md:
          https://github.com/ValentinTorassa/blackice/blob/v@@VERSION@@/docs/linux.md
      EOS
    end

    <<~EOS
      Homebrew installs only the CLI. Linux x86_64 task scopes require separate manual setup:
        1. Clone tag v@@VERSION@@ from https://github.com/ValentinTorassa/blackice.git.
        2. Download that tag's release files into a directory inside the checkout.
           In that directory, verify the manifest against the tag and checkout commit:
             gh attestation verify SHA256SUMS --repo ValentinTorassa/blackice --signer-workflow ValentinTorassa/blackice/.github/workflows/release.yml --source-ref refs/tags/v@@VERSION@@ --source-digest "$(git rev-parse HEAD)" --deny-self-hosted-runners
             sha256sum -c SHA256SUMS
        3. From the checkout, run zig build -Doptimize=ReleaseSafe using the tag's Zig version.
           The SHA-256 of zig-out/bin/blackice-linux-helper must match the manifest's
           blackice-linux-helper-@@VERSION@@-x86_64-linux entry. Stop on any failed check.
        4. Review the checkout's scripts, then follow its two-argument linux-setup.sh
           procedure with your user name and the verified helper digest.

      Full procedure and Linux requirements:
        https://github.com/ValentinTorassa/blackice/blob/v@@VERSION@@/packaging/homebrew/README.md
        https://github.com/ValentinTorassa/blackice/blob/v@@VERSION@@/docs/linux.md
      Setup and teardown scripts come from the tag checkout; they have no separate attestations.
    EOS
  end

  test do
    system bin/"blackice", "version"
  end
end
