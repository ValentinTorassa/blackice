[Unit]
Description=blackice application network filter
Requires=blackice-appfilter-bpffs.service blackice-appfilter.socket
After=blackice-appfilter-bpffs.service blackice-appfilter.socket
# A backstop only. While the filter is off the service is started once per control request, so a low burst
# would stop the socket after a few status calls. Crash loops are slowed by the restart backoff below.
StartLimitIntervalSec=600
StartLimitBurst=60

[Service]
Type=simple
User=blackice-appfilter
Group=blackice-appfilter
ExecStart=/usr/local/libexec/blackice-linux-appfilter --service
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
PrivateDevices=yes
ReadWritePaths=/run/blackice-appfilter/bpf /var/lib/blackice-appfilter
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
UMask=0027
LimitNOFILE=8192
TasksMax=1024
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=60
# Pinned programs, links and maps survive service stop and crash. No ExecStop unpins them.
# No MemoryMax: the fixed tag array alone requires 16 MiB of kernel memory.
