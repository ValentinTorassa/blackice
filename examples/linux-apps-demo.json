{
  "version": "blackice.apps/v0",
  "applications": [
    {
      "executable": "/usr/lib/firefox-esr/firefox-esr",
      "policy": {
        "version": "blackice.policy/v0",
        "network": { "mode": "allowlist", "allow": ["example.com", "example.org"] }
      }
    },
    {
      "executable": "/usr/bin/wget",
      "policy": {
        "version": "blackice.policy/v0",
        "network": { "mode": "allowlist", "allow": ["example.org"] }
      }
    },
    {
      "executable": "/usr/bin/curl",
      "policy": {
        "version": "blackice.policy/v0",
        "network": { "mode": "allowlist", "allow": ["example.com"] }
      }
    }
  ]
}
